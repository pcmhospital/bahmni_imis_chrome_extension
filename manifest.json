{
  "manifest_version": 3,
  "name": "IMIS Sync",
  "version": "1.0.2",
  "description": "Adds an IMIS Sync button to Bahmni Registration that checks NHIS patient eligibility and shows patient status from IMIS.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {},
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://192.168.1.3/bahmni/registration/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["notifications", "storage", "alarms"],
  "host_permissions": [
    "https://192.168.1.3/*",
    "https://cdn.jsdelivr.net/*",
    "https://github.com/*",
    "https://api.github.com/*"
  ]
}